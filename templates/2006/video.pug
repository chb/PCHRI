extends layout.pug

block title
    title.
        PCHRI 2006 | Meeting Videos

mixin video(url, title)
    figure.video
        iframe(
            src=url
            title=title
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
        )
        figcaption
            a(href=url target="_blank" alt=title)= title

block content
    .padding

        h1 Meeting Videos

        section
            ul.sectionlist
                li
                    a(href="#top") Keynotes
                li
                    a(href="#content16") Panels
                //- li
                    a(href="#content17") CBMI Award for PCHR Innovation
        
        section
            a(name="content15"): h2 Keynotes
            +video("https://www.youtube.com/embed/6tt5xNEwo7E?list=PLUmUAg5OoySe2989SPSgGR3W6QmIX3Wxp", "Meeting Introduction, John Halamka")
            +video("https://www.youtube.com/embed/7NcytrDTrsc?list=PLUmUAg5OoySe2989SPSgGR3W6QmIX3Wxp", "PCHRI Keynote, M Kapor")

        section
            a(name="content16"): h2 Panels
            +video("https://www.youtube.com/embed/Cb-BwCXE-dI?list=PLUmUAg5OoySe2989SPSgGR3W6QmIX3Wxp", "PCHRI Personally Controlled Health Records in Clinical Care")
            +video("https://www.youtube.com/embed/HZHcFd1Cvrg?list=PLUmUAg5OoySe2989SPSgGR3W6QmIX3Wxp", "PCHRI PCHRs and Population Health")

        //- section
            a(name="content17"): h2 CBMI Award for PCHR Innovation
            
            +video("", "Presentation to Professor Pete Szolovits")